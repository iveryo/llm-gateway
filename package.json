{
  "name": "llm-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAI and Anthropic protocol gateway with transparent proxying, adaptation, logs, and usage stats.",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sql.js": "^1.13.0",
    "vite": "^7.2.2"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "electron-builder": "^26.8.1",
    "electron": "^39.2.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.7"
  },
  "build": {
    "appId": "com.llm.gateway",
    "productName": "LLM Gateway",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
